@using EposRetail.Models
@inject DepartmentButtonsLayoutStorage LayoutStorage
@inject UserSessionService UserSessionService
@inject ProductServices ProductServices
@implements IDisposable

@foreach (var row in ButtonRows)
{
    <div class="gap-2 d-flex align-items-start ms-2 mb-2">
        @foreach (var button in row)
        {
            <button class="btn btn-light @button.CssClass d-flex flex-column align-items-center flex-fill"
                    @onclick="() => HandleButtonClick(button)">
                <img src="@button.IconPath" class="img-fluid mb-2" />
                <span class="fw-bold">@button.Label</span>
            </button>
        }
    </div>
}

@if (CurrentGroupKey == null)
{
    <PayoutButtonComponents PayoutClick="OnPayoutClick"></PayoutButtonComponents>
}




@code {
    [Parameter] public CheckoutState State { get; set; } = new();
    [Parameter] public EventCallback<string> OnDepartmentClick { get; set; }
    [Parameter] public EventCallback<int> OnCashSuggestionClick { get; set; }
    [Parameter] public EventCallback<PayoutActionModel> OnPayoutClick { get; set; }

    bool IsCollapsed { get; set; } = false;
    private DepartmentButtonsLayoutConfig Layout { get; set; } = new();
    private string? CurrentGroupKey { get; set; }

    private IEnumerable<DepartmentButtonConfig> DisplayButtons
    {
        get
        {
            if (string.IsNullOrWhiteSpace(CurrentGroupKey))
            {
                return Layout.RootButtons;
            }

            if (Layout.Groups.TryGetValue(CurrentGroupKey, out var groupButtons))
            {
                return GetBackButton().Concat(groupButtons);
            }

            return GetBackButton();
        }
    }

    private IEnumerable<IEnumerable<DepartmentButtonConfig>> ButtonRows => DisplayButtons
        .OrderBy(b => b.Position)
        .Chunk(4)
        .Select(chunk => chunk.AsEnumerable());

    protected override async Task OnInitializedAsync()
    {
        await LoadLayoutAsync();
        UserSessionService.OnBusinessSettingChanged += HandleBusinessSettingChanged;
    }

    private void HandleBusinessSettingChanged()
    {
        _ = InvokeAsync(LoadLayoutAsync);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserSessionService.OnBusinessSettingChanged -= HandleBusinessSettingChanged;
    }

    private void CollapseDepartmentClick()
    {
        IsCollapsed = !IsCollapsed;
    }

    private async Task HandleCashSuggestionClick(int amount)
    {
        if (OnCashSuggestionClick.HasDelegate)
            await OnCashSuggestionClick.InvokeAsync(amount);
    }

    private async Task HandleButtonClick(DepartmentButtonConfig button)
    {
        if (button.TargetType == DepartmentButtonTargetType.Group)
        {
            if (button.Label == "Back")
            {
                CurrentGroupKey = null;
                return;
            }

            var groupKey = (button.GroupKey ?? button.PageRoute)?.Trim();
            if (string.IsNullOrWhiteSpace(groupKey))
            {
                return;
            }

            CurrentGroupKey = groupKey;
            return;
        }

        var barcode = button.ProductBarcode?.Trim();
        if (!string.IsNullOrWhiteSpace(barcode))
        {
            await OnDepartmentClick.InvokeAsync(barcode);
            if (!string.IsNullOrWhiteSpace(CurrentGroupKey))
            {
                CurrentGroupKey = null;
            }
        }
        else if(!string.IsNullOrWhiteSpace(button.Label))
        {
            var label = button.Label.Trim();

            Product? matchedProduct = null;
            try
            {
                var exactMatches = (await ProductServices.GetByConditionAsync(
                    p => p.Is_Activated && !p.Is_Deleted && p.Product_Name == label,
                    includeMapping: false)).ToList();

                if (exactMatches.Count == 1)
                {
                    matchedProduct = exactMatches[0];
                }
                else if (exactMatches.Count == 0)
                {
                    var caseInsensitiveMatches = (await ProductServices.GetByConditionAsync(
                        p => p.Is_Activated && !p.Is_Deleted && EF.Functions.ILike(p.Product_Name, label),
                        includeMapping: false)).ToList();

                    if (caseInsensitiveMatches.Count == 1)
                    {
                        matchedProduct = caseInsensitiveMatches[0];
                    }
                }
            }
            catch
            {
                matchedProduct = null;
            }

            if (matchedProduct != null && !string.IsNullOrWhiteSpace(matchedProduct.Product_Barcode))
            {
                button.ProductBarcode = matchedProduct.Product_Barcode;

                var siteId = UserSessionService.CurrentSite?.Id;
                if (siteId.HasValue)
                {
                    await LayoutStorage.SaveAsync(siteId.Value, UserSessionService.CurrentTill?.Id, Layout);
                }

                await OnDepartmentClick.InvokeAsync(matchedProduct.Product_Barcode);
            }
            else
            {
                await OnDepartmentClick.InvokeAsync(label);
            }

            if (!string.IsNullOrWhiteSpace(CurrentGroupKey))
            {
                CurrentGroupKey = null;
            }

        }
    }

    private async Task LoadLayoutAsync()
    {
        var siteId = UserSessionService.CurrentSite?.Id;
        if (!siteId.HasValue)
        {
            Layout = LayoutStorage.CreateDefaultLayout();
            CurrentGroupKey = null;
            return;
        }

        Layout = await LayoutStorage.LoadAsync(siteId.Value, UserSessionService.CurrentTill?.Id);
        if (!string.IsNullOrWhiteSpace(CurrentGroupKey) && !Layout.Groups.ContainsKey(CurrentGroupKey))
        {
            CurrentGroupKey = null;
        }
    }

    private static IEnumerable<DepartmentButtonConfig> GetBackButton() =>
        new[]
        {
            new DepartmentButtonConfig
            {
                Position = 1,
                Label = "Back",
                IconPath = "images/icons/svg/arrow_circle_left_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
                CssClass = "background-colour-light-yellow",
                TargetType = DepartmentButtonTargetType.Group,
                GroupKey = ""
            }
        };

}
