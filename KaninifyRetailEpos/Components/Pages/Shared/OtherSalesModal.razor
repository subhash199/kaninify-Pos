@using System.Globalization
@using EposRetail.Models
@inject ProductServices ProductServices

<div class="@((IsVisible) ? "" : "d-none")">
    <!-- Modal Backdrop -->
    <div class="modal-backdrop fade show" style="z-index: 1040;" @onclick="CloseModal"></div>

    <!-- Modal Dialog -->
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@HeaderTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <div class="form-group">
                                <label for="amountInput" class="form-label h4">@InputLabel</label>
                                @if (IsItemSelected)
                                {
                                    <input @ref="amountInputRef"
                                           @bind="Amount"
                                           @bind:event="oninput"
                                           @onkeypress="HandleKeyPress"
                                           id="amountInput"
                                           type="text"
                                           class="form-control form-control-lg text-center"
                                           style="font-size: 2rem; font-weight: bold; border: 2px solid #007bff;"
                                           inputmode="decimal"
                                           placeholder="@InputPlaceholder" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Main Content Area -->
                    <div class="row">
                        <!-- Left Side - Department Buttons -->
                        <div class="col-md-6">
                            <DepartmentButtons State="@State"
                                               OnDepartmentClick="HandleDepartmentSelected"
                                               OnCashSuggestionClick="HandleCashSuggestionClick"
                                               OnPayoutClick="HandlePayoutClick" />
                        </div>

                        <!-- Right Side - Number Pad -->
                        <div class="col-md-6">
                            <NumberPadComponent Numbers="NumberPadNumbers"
                                                Disabled="@(!IsItemSelected)"
                                                OnNumberClick="HandleNumberClick" />
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary on-hover-color" @onclick="HandleOkClick">OK</button>
                    <button type="button" class="btn btn-secondary on-hover-color" @onclick="CloseModal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Validation Message Modal -->
<GenericMessageModal IsVisible="@showValidationModal"
                     Title="@validationTitle"
                     Message="@validationMessage"
                     PrimaryButtonText="OK"
                     PrimaryAction="CloseValidationModal"
                     OnClose="CloseValidationModal" />

@code {
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<(string department, decimal amount)> OnDepartmentWithAmountSelected { get; set; }
    [Parameter] public EventCallback<(PayoutType payoutType, decimal amount)> OnPayoutWithAmount { get; set; }
    [Parameter] public EventCallback OnModalClosed { get; set; }
    [Parameter] public CheckoutState State { get; set; } = new();

    private ElementReference amountInputRef;
    private string _amount = "";
    private string SelectedDepartment = "";
    private string SelectedItemName = "";
    private bool SelectedItemIsWeighted;
    private PayoutActionModel? SelectedPayout;
    private static readonly List<string> NumberPadNumbers = new() { "7", "8", "9", "4", "5", "6", "1", "2", "3", "0", "00", "Clear" };

    // Validation modal properties
    private bool showValidationModal = false;
    private string validationTitle = "";
    private string validationMessage = "";
    private bool IsItemSelected => !string.IsNullOrWhiteSpace(SelectedDepartment) || SelectedPayout != null;
    private string HeaderTitle => !IsItemSelected
        ? "Select an item"
        : SelectedItemIsWeighted ? "Enter Weight - " + SelectedItemName : "Enter Amount - " + SelectedItemName;
    private string InputLabel => !IsItemSelected
        ? "Select an item"
        : SelectedItemIsWeighted ? "Enter Weight" : "Amount";
    private string InputPlaceholder => SelectedItemIsWeighted ? "0.000" : "0.00";
    private string DisplayAmount => string.IsNullOrWhiteSpace(Amount)
        ? (SelectedItemIsWeighted ? "0.000" : "0.00")
        : Amount;

    public string Amount
    {
        get => _amount;
        set
        {
            _amount = NormalizeAmount(value);
            StateHasChanged();
        }
    }

    private async Task HandleOkClick()
    {
        await SubmitSelection();
    }
    private async Task HandleNumberClick(string number)
    {
        if (!IsItemSelected)
        {
            return;
        }

        if (number == "Clear")
        {
            Amount = "";
        }
        else
        {
            var newAmount = BuildNextAmount(number);
            if (newAmount == Amount)
            {
                return;
            }

            Amount = newAmount;
        }

        await FocusAmountInput();
    }

    private async Task HandleDepartmentSelected(string department)
    {
        SelectedDepartment = department;
        SelectedPayout = null;
        Amount = "";

        var matchedProduct = await ProductServices.GetProductByBarcode(department, false, true);
        SelectedItemName = matchedProduct?.Product_Name ?? department;
        SelectedItemIsWeighted = matchedProduct?.Is_Weighted ?? false;
        StateHasChanged();
    }

    
    private Task HandleCashSuggestionClick(int amount)
    {
        if (!IsItemSelected)
        {
            return Task.CompletedTask;
        }

        Amount = SelectedItemIsWeighted
            ? amount.ToString("F3", CultureInfo.InvariantCulture)
            : amount.ToString("F2", CultureInfo.InvariantCulture);

        return Task.CompletedTask;
    }

    private Task HandlePayoutClick(PayoutActionModel payout)
    {
        SelectedPayout = payout;
        SelectedDepartment = "";
        SelectedItemName = payout.PayoutType.ToString();
        SelectedItemIsWeighted = false;
        Amount = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SubmitSelection()
    {
        if (!IsItemSelected)
        {
            validationTitle = "Selection Required";
            validationMessage = "Please select an item before entering a value.";
            showValidationModal = true;
            StateHasChanged();
            return;
        }

        if (!decimal.TryParse(Amount, NumberStyles.Number, CultureInfo.InvariantCulture, out var enteredAmount) || enteredAmount <= 0)
        {
            validationTitle = SelectedItemIsWeighted ? "Weight Required" : "Amount Required";
            validationMessage = SelectedItemIsWeighted
                ? "Please enter a valid weight greater than 0."
                : "Please enter a valid amount greater than 0.";
            showValidationModal = true;
            StateHasChanged();
            return;
        }

        if (SelectedPayout != null)
        {
            await OnPayoutWithAmount.InvokeAsync((SelectedPayout.PayoutType, enteredAmount));
            await CloseModal();
            return;
        }

        await OnDepartmentWithAmountSelected.InvokeAsync((SelectedDepartment, enteredAmount));
        await CloseModal();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseModal();
        }
    }

    private async Task CloseModal()
    {
        IsVisible = false;
        ResetSelection();
        await IsVisibleChanged.InvokeAsync(IsVisible);
        await OnModalClosed.InvokeAsync();
    }

    private async Task CloseValidationModal()
    {
        showValidationModal = false;
        StateHasChanged();
    }

    public async Task ShowModal()
    {
        IsVisible = true;
        ResetSelection();
        await IsVisibleChanged.InvokeAsync(IsVisible);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible)
        {
            await Task.Delay(100);
            await FocusAmountInput();
        }
    }

    private string BuildNextAmount(string number)
    {
        if (string.IsNullOrWhiteSpace(number))
        {
            return Amount;
        }

        var incomingDigits = ExtractDigits(number);
        if (string.IsNullOrEmpty(incomingDigits))
        {
            return Amount;
        }

        var existingDigits = ExtractDigits(Amount);
        var combinedDigits = existingDigits + incomingDigits;
        return FormatAmountFromDigits(combinedDigits);
    }

    private string NormalizeAmount(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var maxDecimalPlaces = SelectedItemIsWeighted ? 3 : 2;
        var builder = new System.Text.StringBuilder();
        var hasDecimalPoint = false;
        var decimalCount = 0;

        foreach (var character in value.Trim())
        {
            if (char.IsDigit(character))
            {
                if (!hasDecimalPoint || decimalCount < maxDecimalPlaces)
                {
                    builder.Append(character);
                    if (hasDecimalPoint)
                    {
                        decimalCount++;
                    }
                }
            }
            else if (character == '.' && !hasDecimalPoint)
            {
                if (builder.Length == 0)
                {
                    builder.Append('0');
                }

                builder.Append(character);
                hasDecimalPoint = true;
            }
        }

        return builder.ToString();
    }

    private string ExtractDigits(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var builder = new System.Text.StringBuilder();
        foreach (var character in value)
        {
            if (char.IsDigit(character))
            {
                builder.Append(character);
            }
        }

        return builder.ToString();
    }

    private string FormatAmountFromDigits(string digits)
    {
        var decimalPlaces = SelectedItemIsWeighted ? 3 : 2;
        var normalizedDigits = string.IsNullOrWhiteSpace(digits)
            ? "0"
            : digits.TrimStart('0');

        if (string.IsNullOrEmpty(normalizedDigits))
        {
            normalizedDigits = "0";
        }

        var paddedDigits = normalizedDigits.PadLeft(decimalPlaces + 1, '0');
        var integerLength = paddedDigits.Length - decimalPlaces;
        var integerPart = paddedDigits.Substring(0, integerLength);
        var fractionalPart = paddedDigits.Substring(integerLength, decimalPlaces);

        return $"{integerPart}.{fractionalPart}";
    }

    private async Task FocusAmountInput()
    {
        try
        {
            await amountInputRef.FocusAsync();
        }
        catch
        {
            // Ignore focus errors
        }
    }

    private void ResetSelection()
    {
        Amount = "";
        SelectedDepartment = "";
        SelectedItemName = "";
        SelectedItemIsWeighted = false;
        SelectedPayout = null;
    }
}
