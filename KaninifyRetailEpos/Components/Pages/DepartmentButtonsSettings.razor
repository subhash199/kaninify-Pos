@page "/department-buttons-settings"
@using EposRetail.Models
@using EposRetail.Components.Pages.Shared
@inject DepartmentButtonsLayoutStorage LayoutStorage
@inject ProductServices ProductServices
@inject GlobalErrorLogService GlobalErrorLogService
@inject UserSessionService UserSessionService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="department-buttons-container">
    <div class="department-buttons-header">
        <div class="header-content">
            <div class="header-left">
                <h1 class="page-title">Department Buttons</h1>
                @if (string.IsNullOrWhiteSpace(editingGroupKey))
                {
                    <p class="page-subtitle">Configure each button to open a submenu or add a specific product (by barcode).</p>
                }
                else
                {
                    <p class="page-subtitle">Editing submenu: @editingGroupKey</p>
                }
            </div>
            <div class="header-right d-flex align-items-center flex-wrap">
                <button class="nav-btn checkout-btn me-2 mb-2" @onclick="NavigateToCheckout">
                    <i class="bi bi-cart"></i>
                    <span>Checkout</span>
                </button>
                <button class="nav-btn back-btn me-2 mb-2" @onclick="NavigateBackoffice">
                    <i class="bi bi-arrow-left"></i>
                    <span>Backoffice</span>
                </button>
                <button class="nav-btn me-2 mb-2" @onclick="ResetToDefaults" disabled="@isSaving">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>
                <button class="nav-btn mb-2" @onclick="SaveAsync" disabled="@isSaving">
                    <i class="bi bi-save"></i>
                    <span>Save</span>
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-muted">Loading…</div>
    }
    else
    {
        @foreach (var row in DisplayButtons.OrderBy(b => b.Position).Chunk(4))
        {
            <div class="row g-2 ms-2 mb-2">
                @foreach (var button in row)
                {
                    <div class="col-md-3">
                        <button class="btn btn-light @button.CssClass d-flex flex-column align-items-center w-100 mb-2" disabled>
                            <img src="@button.IconPath" class="img-fluid mb-2" />
                            <span class="fw-bold">@button.Label</span>
                        </button>

                        <div class="d-flex gap-2 mb-2">
                            <input class="form-control form-control-sm" @bind="button.Label" placeholder="Label" maxlength="12" />
                        </div>

                        <div class="d-flex gap-2 align-items-center mb-2">
                            <button class="change-icon-btn" type="button" @onclick="() => OpenIconPicker(button)">Change Icon</button>
                            <img src="@button.IconPath" class="icon-preview icon-preview--sm" />
                        </div>

                        <div class="d-flex gap-2 mb-2">
                            <select class="form-select form-select-sm" @bind="button.CssClass">
                                <option value="background-colour-light-red">Red</option>
                                <option value="background-colour-light-green">Green</option>
                                <option value="background-colour-light-yellow">Yellow</option>
                                <option value="background-colour-light-blue">Blue</option>
                                <option value="background-colour-light-pink">Pink</option>
                                <option value="background-colour-light-tomato">Tomato</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2 mb-2">
                            <select class="form-select form-select-sm" @bind="button.TargetType">
                                <option value="@DepartmentButtonTargetType.Product">Product</option>
                                <option value="@DepartmentButtonTargetType.Group">Submenu</option>
                            </select>
                        </div>

                        @if (button.TargetType == DepartmentButtonTargetType.Product)
                        {
                            <select class="form-select form-select-sm"
                                    @bind="button.ProductBarcode"
                                    @bind:after="() => OnProductBarcodeChangedAsync(button)">
                                <option value="">Select product…</option>
                                <option value="@CreateNewProductSentinel">+ Create New Product</option>
                                @foreach (var product in Products)
                                {
                                    <option value="@product.Product_Barcode">@product.Product_Name (@product.Product_Barcode)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <button class="form-select form-select-sm text-center"
                                    type="button"
                                    @onclick="() => EditGroup(button)">Edit</button>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(editingGroupKey))
        {
            <div class="row g-2 ms-2 mb-2">
                <div class="col-md-3">
                    <button class="btn btn-light d-flex flex-column align-items-center w-100"
                            @onclick="AddButtonToCurrentGroup"
                            disabled="@(!CanAddButtonToCurrentGroup)">
                        <img src="images/icons/svg/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg" class="img-fluid mb-2" style="width: 28px; height: 28px;" />
                        <span class="fw-bold">Add Button</span>
                    </button>
                </div>
            </div>
        }
    }
</div>

<ProductModal IsVisible="@isCreateProductModalVisible"
              Title="Create Product"
              Product="@newProduct"
              PrimaryButtonText="Save"
              SecondaryButtonText="Cancel"
              OnSave="HandleProductCreated"
              OnClose="CloseCreateProductModal" />

@if (isIconPickerVisible)
{
    <div class="modal-backdrop fade show" style="z-index: 1040;" @onclick="CloseIconPicker"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Icon</h5>
                    <button type="button" class="btn-close" @onclick="CloseIconPicker" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <input class="form-control" placeholder="Search icons…" @bind="iconSearchTerm" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6 d-flex justify-content-end align-items-center">
                            @if (iconTargetButton != null)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="text-muted">Current</span>
                                    <img src="@iconTargetButton.IconPath" class="icon-preview icon-preview--sm" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var icon in FilteredIcons)
                        {
                            <button type="button" class="btn btn-light" style="width: 64px; height: 64px;" @onclick="() => SelectIcon(icon)">
                                <img src="@icon" class="img-fluid" style="max-width: 36px; max-height: 36px;" />
                            </button>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseIconPicker">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
