    private bool isSaving = false;
    private List<Product> Products { get; set; } = new();
    private DepartmentButtonsLayoutConfig Layout { get; set; } = new();
    private string? editingGroupKey;
    private List<DepartmentButtonConfig> DisplayButtons =>
        string.IsNullOrWhiteSpace(editingGroupKey)
            ? Layout.RootButtons
            : Layout.Groups.TryGetValue(editingGroupKey, out var groupButtons) ? groupButtons : new();
    private const string CreateNewProductSentinel = "__CREATE_NEW_PRODUCT__";
    private bool isCreateProductModalVisible;
    private Product newProduct = new();
    private DepartmentButtonConfig? pendingProductButton;
    private bool isIconPickerVisible;
    private DepartmentButtonConfig? iconTargetButton;
    private string iconSearchTerm = "";
    private static readonly List<string> DefaultIcons = new()
    {
