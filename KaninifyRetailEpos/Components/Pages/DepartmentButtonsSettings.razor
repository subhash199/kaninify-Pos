        "images/icons/svg/account_balance_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/account_balance_wallet_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/add_shopping_cart_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/apps_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/arrow_circle_left_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/arrow_menu_open_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/assignment_add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/bar_chart_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/campaign_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/cards_star_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/casino_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/category_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/check_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/clear_all_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/close_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/close_fullscreen_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/expand_content_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/finance_mode_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/front_hand_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/grocery_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/hide_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/history_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/icecream_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/inventory_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/liquor_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/loyalty_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/manage_accounts_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/markdown_paste_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/mode_cool_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/money_bag_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/money_off_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/nutrition_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/payments_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/print_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/receipt_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/remove_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/search_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/send_money_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/settings_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/smoking_rooms_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/snowing_heavy_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/store_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/timer_off_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/user_attributes_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/volunteer_activism_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/weather_hail_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/wifi_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg"
    };
    private List<string> AvailableIcons { get; set; } = new();

    private IEnumerable<string> FilteredIcons =>
        string.IsNullOrWhiteSpace(iconSearchTerm)
            ? AvailableIcons
            : AvailableIcons.Where(i => i.Contains(iconSearchTerm.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadProductsAsync();
            await LoadLayoutFromStorageAsync();
            await LoadIconsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task LoadIconsAsync()
    {
        try
        {
            var candidates = new[]
            {
                Path.Combine(AppContext.BaseDirectory, "wwwroot", "images", "icons", "svg"),
                Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "icons", "svg")
            };

            foreach (var dir in candidates)
            {
                if (!Directory.Exists(dir))
                    continue;

                var icons = Directory
                    .GetFiles(dir, "*.svg", SearchOption.TopDirectoryOnly)
                    .Select(Path.GetFileName)
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Select(name => $"images/icons/svg/{name}")
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (icons.Count > 0)
                {
                    AvailableIcons = icons;
                    return Task.CompletedTask;
                }
            }
        }
        catch
        {
        }

        AvailableIcons = DefaultIcons
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();
        return Task.CompletedTask;
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            var products = await ProductServices.GetByConditionAsync(p => p.Is_Activated && !p.Is_Deleted, includeMapping: false);
            Products = products
                .OrderBy(p => p.Product_Name)
                .ThenBy(p => p.Product_Barcode)
                .ToList();
        }
        catch (Exception ex)
        {
            await GlobalErrorLogService.LogErrorAsync(ex, nameof(LoadProductsAsync), "Loading products for department button settings");
            Products = new();
        }
    }

    private async Task LoadLayoutFromStorageAsync()
    {
        var siteId = UserSessionService.CurrentSite?.Id;
        if (!siteId.HasValue)
        {
            Layout = LayoutStorage.CreateDefaultLayout();
            return;
        }

        Layout = await LayoutStorage.LoadAsync(siteId.Value, UserSessionService.CurrentTill?.Id);

        foreach (var button in Layout.RootButtons.Concat(Layout.Groups.SelectMany(g => g.Value)))
        {
            if (button.TargetType != DepartmentButtonTargetType.Product)
                continue;

            if (button.ProductBarcode == CreateNewProductSentinel)
            {
                button.ProductBarcode = "";
            }
        }
    }

    private async Task SaveAsync()
    {
        var siteId = UserSessionService.CurrentSite?.Id;
        if (!siteId.HasValue)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No site selected. Please login again.");
            return;
        }

        isSaving = true;
        try
        {
            await LayoutStorage.SaveAsync(siteId.Value, UserSessionService.CurrentTill?.Id, Layout);
            UserSessionService.SetBusinessSetting(UserSessionService.CurrentBusinessSetting);
            await JSRuntime.InvokeVoidAsync("alert", "Department buttons saved.");
        }
        catch (Exception ex)
        {
            await GlobalErrorLogService.LogErrorAsync(ex, nameof(SaveAsync), "Saving department button settings");
            await JSRuntime.InvokeVoidAsync("alert", "Failed to save department buttons.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetToDefaults()
    {
        Layout = LayoutStorage.CreateDefaultLayout();
        editingGroupKey = null;
    }

    private void NavigateBackoffice()
    {
        NavigationManager.NavigateTo("/backoffice");
    }

    private void NavigateToCheckout()
    {
        NavigationManager.NavigateTo("/checkout");
    }

    private void ExitGroupEditor()
    {
        editingGroupKey = null;
    }

    private void EditGroup(DepartmentButtonConfig button)
    {
        var key = button.GroupKey?.Trim();
        if (string.IsNullOrWhiteSpace(key))
        {
            key = NormalizeGroupKey(button.Label);
            button.GroupKey = key;
        }

        EnsureGroupExists(key);
        editingGroupKey = key;
    }

    private async Task OnProductBarcodeChangedAsync(DepartmentButtonConfig button)
    {
        if (button.ProductBarcode != CreateNewProductSentinel)
            return;

        button.ProductBarcode = "";
        await OpenCreateProductModal(button);
    }

    private async Task OpenCreateProductModal(DepartmentButtonConfig button)
    {
        pendingProductButton = button;
        newProduct = new Product
        {
            Product_Barcode = "",
            Product_Name = "",
            Product_Selling_Price = 0,
            ShelfQuantity = 0,
            StockroomQuantity = 0,
            Expiry_Date = DateTime.UtcNow.AddMonths(1),
            Is_Activated = true,
            Is_Deleted = false
        };
        isCreateProductModalVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleProductCreated(Product created)
    {
        isCreateProductModalVisible = false;

        if (created != null)
        {
            if (pendingProductButton != null)
            {
                pendingProductButton.ProductBarcode = created.Product_Barcode;
                pendingProductButton.Label = created.Product_Name;
            }

            await LoadProductsAsync();
        }

        pendingProductButton = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseCreateProductModal()
    {
        isCreateProductModalVisible = false;
        pendingProductButton = null;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenIconPicker(DepartmentButtonConfig button)
    {
        iconTargetButton = button;
        iconSearchTerm = "";
        isIconPickerVisible = true;
    }

    private void CloseIconPicker()
    {
        isIconPickerVisible = false;
        iconTargetButton = null;
        iconSearchTerm = "";
    }

    private void SelectIcon(string iconPath)
    {
        if (iconTargetButton != null)
        {
            iconTargetButton.IconPath = iconPath;
        }
        CloseIconPicker();
    }

    private void EnsureGroupExists(string groupKey)
    {
        if (Layout.Groups.ContainsKey(groupKey))
            return;

        Layout.Groups[groupKey] = new List<DepartmentButtonConfig>();
    }

    private bool CanAddButtonToCurrentGroup
    {
        get
        {
            if (string.IsNullOrWhiteSpace(editingGroupKey))
                return false;
            if (!Layout.Groups.TryGetValue(editingGroupKey, out var list))
                return true;
            return list.Count < 12;
        }
    }

    private void AddButtonToCurrentGroup()
    {
        if (string.IsNullOrWhiteSpace(editingGroupKey))
            return;

        EnsureGroupExists(editingGroupKey);
        var list = Layout.Groups[editingGroupKey];
        if (list.Count >= 12)
            return;

        var used = new HashSet<int>(list.Select(b => b.Position));
        var nextPos = Enumerable.Range(2, 12).FirstOrDefault(p => !used.Contains(p));
        if (nextPos == 0)
            return;

        list.Add(new DepartmentButtonConfig
        {
            Position = nextPos,
            Label = "New Button",
            IconPath = "images/icons/svg/apps_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
            CssClass = "background-colour-light-green",
            TargetType = DepartmentButtonTargetType.Product,
            ProductBarcode = ""
        });
    }

    private static string NormalizeGroupKey(string label)
    {
        if (string.IsNullOrWhiteSpace(label))
            return Guid.NewGuid().ToString("N");

        var chars = label
            .Where(c => char.IsLetterOrDigit(c))
            .Select(char.ToLowerInvariant)
            .ToArray();

        var key = new string(chars);
        if (string.IsNullOrWhiteSpace(key))
            return Guid.NewGuid().ToString("N");

        return key;
    }

}
