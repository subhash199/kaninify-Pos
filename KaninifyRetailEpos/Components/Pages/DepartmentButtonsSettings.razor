@page "/department-buttons-settings"
@using EposRetail.Models
@using EposRetail.Components.Pages.Shared
@using Microsoft.AspNetCore.Components.Routing
@using System.Text.Json
@inject DepartmentButtonsLayoutStorage LayoutStorage
@inject ProductServices ProductServices
@inject GlobalErrorLogService GlobalErrorLogService
@inject UserSessionService UserSessionService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<div class="department-buttons-container">
    <div class="department-buttons-header">
        <div class="header-content">
            <div class="header-left">
                <h1 class="page-title">Department Buttons</h1>
                @if (string.IsNullOrWhiteSpace(editingGroupKey))
                {
                    <p class="page-subtitle">Configure each button to open a submenu or add a specific product (by barcode).</p>
                }
                else
                {
                    <p class="page-subtitle">Editing submenu: @editingGroupKey</p>
                }
            </div>
            <div class="header-right d-flex align-items-center flex-wrap">
                @if (string.IsNullOrWhiteSpace(editingGroupKey))
                {
                    <button class="nav-btn checkout-btn me-2 mb-2" @onclick="NavigateToCheckout">
                        <i class="bi bi-cart"></i>
                        <span>Checkout</span>
                    </button>
                    <button class="nav-btn back-btn me-2 mb-2" @onclick="NavigateBackoffice">
                        <i class="bi bi-arrow-left"></i>
                        <span>Backoffice</span>
                    </button>
                    <button class="nav-btn me-2 mb-2" @onclick="ResetToDefaults" disabled="@isSaving">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reset</span>
                    </button>
                    <button class="nav-btn mb-2" @onclick="SaveAsync" disabled="@isSaving">
                        <i class="bi bi-save"></i>
                        <span>Save</span>
                    </button>
                }
                else
                {
                    <button class="nav-btn back-btn me-2 mb-2" @onclick="ExitGroupEditor">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back</span>
                    </button>
                    <button class="nav-btn me-2 mb-2" @onclick="ResetCurrentGroup" disabled="@isSaving">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reset</span>
                    </button>
                    <button class="nav-btn mb-2" @onclick="SaveAsync" disabled="@isSaving">
                        <i class="bi bi-save"></i>
                        <span>Save</span>
                    </button>
                }
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-muted">Loading…</div>
    }
    else
    {
        @foreach (var row in DisplayButtons.OrderBy(b => b.Position).Chunk(4))
        {
            <div class="row g-2 ms-2 mb-2">
                @foreach (var button in row)
                {
                    <div class="col-md-3">
                        <button class="btn btn-light @button.CssClass d-flex flex-column align-items-center w-100 mb-2" disabled>
                            <img src="@button.IconPath" class="img-fluid mb-2" />
                            <span class="fw-bold">@button.Label</span>
                        </button>

                        @if (!string.IsNullOrWhiteSpace(editingGroupKey))
                        {
                            <div class="d-flex justify-content-end mb-1">
                                <button class="delete-submenu-btn"
                                        type="button"
                                        @onclick="() => PromptDeleteButton(button)">
                                    <i class="bi bi-trash"></i>
                                    <span class="ms-1">Delete</span>
                                </button>
                            </div>
                        }

                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text">
                                <i class="bi bi-fonts"></i>
                            </span>
                            <input class="form-control"
                                   @bind="button.Label"
                                   @bind:event="oninput"
                                   @bind:after="() => MarkDirty()"
                                   placeholder="Label"
                                   maxlength="12" />
                        </div>

                        <div class="d-flex gap-2 align-items-center mb-2">
                            <button class="change-icon-btn" type="button" @onclick="() => OpenIconPicker(button)">Change Icon</button>
                            <img src="@button.IconPath" class="icon-preview icon-preview--sm" />
                        </div>

                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text">
                                <i class="bi bi-palette"></i>
                            </span>
                            <select class="form-select" @bind="button.CssClass" @bind:after="() => MarkDirty()">
                                <option value="background-colour-light-red">Red</option>
                                <option value="background-colour-light-green">Green</option>
                                <option value="background-colour-light-yellow">Yellow</option>
                                <option value="background-colour-light-blue">Blue</option>
                                <option value="background-colour-light-pink">Pink</option>
                                <option value="background-colour-light-tomato">Tomato</option>
                            </select>
                        </div>

                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text">
                                <i class="bi bi-diagram-3"></i>
                            </span>
                            <select class="form-select" @bind="button.TargetType" @bind:after="() => OnTargetTypeChanged(button)">
                                <option value="@DepartmentButtonTargetType.Product">Product</option>
                                <option value="@DepartmentButtonTargetType.Group">Submenu</option>
                            </select>
                        </div>

                        @if (button.TargetType == DepartmentButtonTargetType.Product)
                        {
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span>
                                <select class="form-select"
                                        @bind="button.ProductBarcode"
                                        @bind:after="() => OnProductBarcodeChangedAsync(button)">
                                    <option value="">Select product…</option>
                                    <option value="@CreateNewProductSentinel">+ Create New Product</option>
                                    @foreach (var product in Products)
                                    {
                                        <option value="@product.Product_Barcode">@product.Product_Name (@product.Product_Barcode)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <button class="edit-submenu-btn"
                                    type="button"
                                    @onclick="() => EditGroup(button)">Edit</button>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(editingGroupKey))
        {
            <div class="row g-2 ms-2 mb-2">
                <div class="col-md-3">
                    <button class="add-submenu-btn d-flex flex-column align-items-center w-100"
                            @onclick="AddButtonToCurrentGroup"
                            disabled="@(!CanAddButtonToCurrentGroup)">
                        <img src="images/icons/svg/add_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg" class="img-fluid mb-2" style="width: 28px; height: 28px;" />
                        <span class="fw-bold">Add Button</span>
                    </button>
                </div>
            </div>
        }
    }
</div>

<ProductModal IsVisible="@isCreateProductModalVisible"
              Title="Create Product"
              Product="@newProduct"
              PrimaryButtonText="Save"
              SecondaryButtonText="Cancel"
              OnSave="HandleProductCreated"
              OnClose="CloseCreateProductModal" />

<GenericMessageModal IsVisible="@isUnsavedChangesModalVisible"
                     Title="Unsaved changes"
                     Message="You have unsaved changes. Do you want to save before leaving?"
                     PrimaryButtonText="Save"
                     PrimaryAction="ConfirmSaveAndNavigateAsync"
                     SecondaryButtonText="Don't save"
                     SecondaryIconLink="images/icons/svg/close_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg"
                     SecondaryAction="ConfirmDiscardAndNavigate"
                     OnClose="CloseUnsavedChangesModal" />

<GenericMessageModal IsVisible="@isDeleteConfirmModalVisible"
                     Title="Delete button"
                     Message="Are you sure you want to delete this submenu button?"
                     PrimaryButtonText="Delete"
                     PrimaryAction="ConfirmDeleteButton"
                     SecondaryButtonText="Cancel"
                     SecondaryIconLink="images/icons/svg/close_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg"
                     SecondaryAction="CloseDeleteConfirmModal"
                     OnClose="CloseDeleteConfirmModal" />

@if (isIconPickerVisible)
{
    <div class="modal-backdrop fade show" style="z-index: 1040;" @onclick="CloseIconPicker"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Icon</h5>
                    <button type="button" class="btn-close" @onclick="CloseIconPicker" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <input class="form-control" placeholder="Search icons…" @bind="iconSearchTerm" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6 d-flex justify-content-end align-items-center">
                            @if (iconTargetButton != null)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="text-muted">Current</span>
                                    <img src="@iconTargetButton.IconPath" class="icon-preview icon-preview--sm" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var icon in FilteredIcons)
                        {
                            <button type="button" class="btn btn-light" style="width: 64px; height: 64px;" @onclick="() => SelectIcon(icon)">
                                <img src="@icon" class="img-fluid" style="max-width: 36px; max-height: 36px;" />
                            </button>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseIconPicker">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private bool hasUnsavedChanges;
    private bool isUnsavedChangesModalVisible;
    private string? pendingNavigationTarget;
    private bool allowNavigationOnce;
    private bool isDeleteConfirmModalVisible;
    private DepartmentButtonConfig? pendingDeleteButton;
    private List<Product> Products { get; set; } = new();
    private DepartmentButtonsLayoutConfig Layout { get; set; } = new();
    private string baselineLayoutSnapshot = "";
    private string? editingGroupKey;
    private string? editingGroupSnapshotKey;
    private List<DepartmentButtonConfig> editingGroupSnapshotButtons = new();
    private List<DepartmentButtonConfig> DisplayButtons =>
        string.IsNullOrWhiteSpace(editingGroupKey)
            ? Layout.RootButtons
            : Layout.Groups.TryGetValue(editingGroupKey, out var groupButtons) ? groupButtons : new();
    private const string CreateNewProductSentinel = "__CREATE_NEW_PRODUCT__";
    private bool isCreateProductModalVisible;
    private Product newProduct = new();
    private DepartmentButtonConfig? pendingProductButton;
    private bool isIconPickerVisible;
    private DepartmentButtonConfig? iconTargetButton;
    private string iconSearchTerm = "";
    private static readonly List<string> DefaultIcons = new()
