        "images/icons/svg/user_attributes_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/volunteer_activism_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/weather_hail_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
        "images/icons/svg/wifi_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg"
    };
    private List<string> AvailableIcons { get; set; } = new();

    private IEnumerable<string> FilteredIcons =>
        string.IsNullOrWhiteSpace(iconSearchTerm)
            ? AvailableIcons
            : AvailableIcons.Where(i => i.Contains(iconSearchTerm.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadProductsAsync();
            await LoadLayoutFromStorageAsync();
            await LoadIconsAsync();
            baselineLayoutSnapshot = CreateLayoutSnapshot(Layout);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task LoadIconsAsync()
    {
        try
        {
            var candidates = new[]
            {
                Path.Combine(AppContext.BaseDirectory, "wwwroot", "images", "icons", "svg"),
                Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "icons", "svg")
            };

            foreach (var dir in candidates)
            {
                if (!Directory.Exists(dir))
                    continue;

                var icons = Directory
                    .GetFiles(dir, "*.svg", SearchOption.TopDirectoryOnly)
                    .Select(Path.GetFileName)
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Select(name => $"images/icons/svg/{name}")
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (icons.Count > 0)
                {
                    AvailableIcons = icons;
                    return Task.CompletedTask;
                }
            }
        }
        catch
        {
        }

        AvailableIcons = DefaultIcons
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();
        return Task.CompletedTask;
    }

    private void MarkDirty()
    {
        hasUnsavedChanges = true;
    }

    private void RecalculateHasUnsavedChanges()
    {
        hasUnsavedChanges = !string.Equals(CreateLayoutSnapshot(Layout), baselineLayoutSnapshot, StringComparison.Ordinal);
    }

    private static DepartmentButtonConfig CloneButton(DepartmentButtonConfig source)
    {
        return new DepartmentButtonConfig
        {
            Position = source.Position,
            Label = source.Label,
            IconPath = source.IconPath,
            CssClass = source.CssClass,
            TargetType = source.TargetType,
            ProductBarcode = source.ProductBarcode,
            PageRoute = source.PageRoute,
            GroupKey = source.GroupKey
        };
    }

    private void CaptureEditingGroupSnapshot(string groupKey)
    {
        if (!Layout.Groups.TryGetValue(groupKey, out var list))
        {
            editingGroupSnapshotKey = groupKey;
            editingGroupSnapshotButtons = new();
            return;
        }

        editingGroupSnapshotKey = groupKey;
        editingGroupSnapshotButtons = list
            .Select(CloneButton)
            .OrderBy(b => b.Position)
            .ToList();
    }

    private static string CreateLayoutSnapshot(DepartmentButtonsLayoutConfig layout)
    {
        var normalized = new DepartmentButtonsLayoutConfig
        {
            Version = layout.Version,
            RootButtons = layout.RootButtons
                .Select(CloneButton)
                .OrderBy(b => b.Position)
                .ToList(),
            Groups = layout.Groups
                .OrderBy(kvp => kvp.Key, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    kvp => kvp.Key,
                    kvp => (kvp.Value ?? new List<DepartmentButtonConfig>())
                        .Select(CloneButton)
                        .OrderBy(b => b.Position)
                        .ToList(),
                    StringComparer.OrdinalIgnoreCase)
        };

        return JsonSerializer.Serialize(normalized, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            WriteIndented = false
        });
    }

    private Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (allowNavigationOnce)
        {
            allowNavigationOnce = false;
            return Task.CompletedTask;
        }

        if (!hasUnsavedChanges)
            return Task.CompletedTask;

        if (isCreateProductModalVisible || isIconPickerVisible || isUnsavedChangesModalVisible)
        {
            context.PreventNavigation();
            return Task.CompletedTask;
        }

        context.PreventNavigation();
        pendingNavigationTarget = context.TargetLocation;
        isUnsavedChangesModalVisible = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            var products = await ProductServices.GetByConditionAsync(p => p.Is_Activated && !p.Is_Deleted, includeMapping: false);
            Products = products
                .OrderBy(p => p.Product_Name)
                .ThenBy(p => p.Product_Barcode)
                .ToList();
        }
        catch (Exception ex)
        {
            await GlobalErrorLogService.LogErrorAsync(ex, nameof(LoadProductsAsync), "Loading products for department button settings");
            Products = new();
        }
    }

    private async Task LoadLayoutFromStorageAsync()
    {
        var siteId = UserSessionService.CurrentSite?.Id;
        if (!siteId.HasValue)
        {
            Layout = LayoutStorage.CreateDefaultLayout();
            return;
        }

        Layout = await LayoutStorage.LoadAsync(siteId.Value, UserSessionService.CurrentTill?.Id);

        foreach (var button in Layout.RootButtons.Concat(Layout.Groups.SelectMany(g => g.Value)))
        {
            if (button.TargetType != DepartmentButtonTargetType.Product)
                continue;

            if (button.ProductBarcode == CreateNewProductSentinel)
            {
                button.ProductBarcode = "";
            }
        }
    }

    private async Task SaveAsync()
    {
        await SaveInternalAsync(showSuccessAlert: true);
    }

    private async Task<bool> SaveInternalAsync(bool showSuccessAlert)
    {
        var siteId = UserSessionService.CurrentSite?.Id;
        if (!siteId.HasValue)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No site selected. Please login again.");
            return false;
        }

        PruneUnconfiguredSubmenuButtons();

        isSaving = true;
        try
        {
            await LayoutStorage.SaveAsync(siteId.Value, UserSessionService.CurrentTill?.Id, Layout);
            UserSessionService.SetBusinessSetting(UserSessionService.CurrentBusinessSetting);
            baselineLayoutSnapshot = CreateLayoutSnapshot(Layout);
            hasUnsavedChanges = false;
            if (showSuccessAlert)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Department buttons saved.");
            }
            return true;
        }
        catch (Exception ex)
        {
            await GlobalErrorLogService.LogErrorAsync(ex, nameof(SaveAsync), "Saving department button settings");
            await JSRuntime.InvokeVoidAsync("alert", "Failed to save department buttons.");
            return false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetToDefaults()
    {
        Layout = LayoutStorage.CreateDefaultLayout();
        editingGroupKey = null;
        MarkDirty();
        RecalculateHasUnsavedChanges();
    }

    private void NavigateBackoffice()
    {
        NavigationManager.NavigateTo("/backoffice");
    }

    private void NavigateToCheckout()
    {
        NavigationManager.NavigateTo("/checkout");
    }

    private void ExitGroupEditor()
    {
        editingGroupKey = null;
        editingGroupSnapshotKey = null;
        editingGroupSnapshotButtons = new();
    }

    private void EditGroup(DepartmentButtonConfig button)
    {
        var didChange = false;
        var key = button.GroupKey?.Trim();
        if (string.IsNullOrWhiteSpace(key))
        {
            key = NormalizeGroupKey(button.Label);
            button.GroupKey = key;
            didChange = true;
        }

        EnsureGroupExists(key);
        CaptureEditingGroupSnapshot(key);
        editingGroupKey = key;
        if (didChange)
        {
            MarkDirty();
        }
    }

    private void ResetCurrentGroup()
    {
        if (string.IsNullOrWhiteSpace(editingGroupKey))
            return;

        if (!string.Equals(editingGroupKey, editingGroupSnapshotKey, StringComparison.OrdinalIgnoreCase))
            return;

        EnsureGroupExists(editingGroupKey);
        Layout.Groups[editingGroupKey] = editingGroupSnapshotButtons
            .Select(CloneButton)
            .OrderBy(b => b.Position)
            .ToList();

        RecalculateHasUnsavedChanges();
    }

    private async Task OnProductBarcodeChangedAsync(DepartmentButtonConfig button)
    {
        if (button.ProductBarcode != CreateNewProductSentinel)
        {
            MarkDirty();
            return;
        }

        button.ProductBarcode = "";
        await OpenCreateProductModal(button);
    }

    private void OnTargetTypeChanged(DepartmentButtonConfig button)
    {
        MarkDirty();
        if (button.TargetType == DepartmentButtonTargetType.Group)
        {
            button.ProductBarcode = "";
        }
        else
        {
            button.GroupKey = null;
        }
    }

    private async Task OpenCreateProductModal(DepartmentButtonConfig button)
    {
        pendingProductButton = button;
        newProduct = new Product
        {
            Product_Barcode = "",
            Product_Name = "",
            Product_Selling_Price = 0,
            ShelfQuantity = 0,
            StockroomQuantity = 0,
            Expiry_Date = DateTime.UtcNow.AddMonths(1),
            Is_Activated = true,
            Is_Deleted = false
        };
        isCreateProductModalVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleProductCreated(Product created)
    {
        isCreateProductModalVisible = false;

        if (created != null)
        {
            if (pendingProductButton != null)
            {
                pendingProductButton.ProductBarcode = created.Product_Barcode;
                pendingProductButton.Label = created.Product_Name;
                MarkDirty();
            }

            await LoadProductsAsync();
        }

        pendingProductButton = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseCreateProductModal()
    {
        isCreateProductModalVisible = false;
        pendingProductButton = null;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenIconPicker(DepartmentButtonConfig button)
    {
        iconTargetButton = button;
        iconSearchTerm = "";
        isIconPickerVisible = true;
    }

    private void CloseIconPicker()
    {
        isIconPickerVisible = false;
        iconTargetButton = null;
        iconSearchTerm = "";
    }

    private void SelectIcon(string iconPath)
    {
        if (iconTargetButton != null)
        {
            iconTargetButton.IconPath = iconPath;
            MarkDirty();
        }
        CloseIconPicker();
    }

    private void EnsureGroupExists(string groupKey)
    {
        if (Layout.Groups.ContainsKey(groupKey))
            return;

        Layout.Groups[groupKey] = new List<DepartmentButtonConfig>();
        MarkDirty();
    }

    private void DeleteButtonFromCurrentGroup(DepartmentButtonConfig button)
    {
        if (string.IsNullOrWhiteSpace(editingGroupKey))
            return;

        if (!Layout.Groups.TryGetValue(editingGroupKey, out var list))
            return;

        var removed = list.RemoveAll(b => b.Position == button.Position) > 0;
        if (removed)
        {
            MarkDirty();
        }
    }

    private void PromptDeleteButton(DepartmentButtonConfig button)
    {
        pendingDeleteButton = button;
        isDeleteConfirmModalVisible = true;
    }

    private Task CloseDeleteConfirmModal()
    {
        isDeleteConfirmModalVisible = false;
        pendingDeleteButton = null;
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmDeleteButton()
    {
        if (pendingDeleteButton != null)
        {
            DeleteButtonFromCurrentGroup(pendingDeleteButton);
        }
        return CloseDeleteConfirmModal();
    }

    private void PruneUnconfiguredSubmenuButtons()
    {
        if (Layout.Groups == null || Layout.Groups.Count == 0)
            return;

        foreach (var key in Layout.Groups.Keys.ToList())
        {
            var list = Layout.Groups[key];
            if (list == null || list.Count == 0)
                continue;

            var before = list.Count;
            list.RemoveAll(IsUnconfiguredNewButton);
            if (list.Count != before)
            {
                MarkDirty();
            }
        }
    }

    private static bool IsUnconfiguredNewButton(DepartmentButtonConfig button)
    {
        var label = (button.Label ?? "").Trim();
        var isDefaultLabel =
            string.IsNullOrWhiteSpace(label) ||
            string.Equals(label, "New Button", StringComparison.OrdinalIgnoreCase) ||
            label.StartsWith("Item ", StringComparison.OrdinalIgnoreCase);

        var isDefaultIcon = string.Equals(
            (button.IconPath ?? "").Trim(),
            "images/icons/svg/apps_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
            StringComparison.OrdinalIgnoreCase);

        var isDefaultColour = string.Equals(
            (button.CssClass ?? "").Trim(),
            "background-colour-light-green",
            StringComparison.OrdinalIgnoreCase);

        var hasTarget = button.TargetType switch
        {
            DepartmentButtonTargetType.Group => !string.IsNullOrWhiteSpace(button.GroupKey),
            _ => !string.IsNullOrWhiteSpace(button.ProductBarcode)
        };

        return !hasTarget && isDefaultLabel && isDefaultIcon && isDefaultColour;
    }

    private bool CanAddButtonToCurrentGroup
    {
        get
        {
            if (string.IsNullOrWhiteSpace(editingGroupKey))
                return false;
            if (!Layout.Groups.TryGetValue(editingGroupKey, out var list))
                return true;
            return list.Count < 12;
        }
    }

    private void AddButtonToCurrentGroup()
    {
        if (string.IsNullOrWhiteSpace(editingGroupKey))
            return;

        EnsureGroupExists(editingGroupKey);
        var list = Layout.Groups[editingGroupKey];
        if (list.Count >= 12)
            return;

        var used = new HashSet<int>(list.Select(b => b.Position));
        var nextPos = Enumerable.Range(2, 12).FirstOrDefault(p => !used.Contains(p));
        if (nextPos == 0)
            return;

        list.Add(new DepartmentButtonConfig
        {
            Position = nextPos,
            Label = "New Button",
            IconPath = "images/icons/svg/apps_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg",
            CssClass = "background-colour-light-green",
            TargetType = DepartmentButtonTargetType.Product,
            ProductBarcode = ""
        });
        MarkDirty();
    }

    private async Task ConfirmSaveAndNavigateAsync()
    {
        if (string.IsNullOrWhiteSpace(pendingNavigationTarget))
        {
            CloseUnsavedChangesModal();
            return;
        }

        var ok = await SaveInternalAsync(showSuccessAlert: false);
        if (!ok)
            return;

        isUnsavedChangesModalVisible = false;
        allowNavigationOnce = true;
        var target = pendingNavigationTarget;
        pendingNavigationTarget = null;
        NavigationManager.NavigateTo(target);
    }

    private void ConfirmDiscardAndNavigate()
    {
        if (string.IsNullOrWhiteSpace(pendingNavigationTarget))
        {
            CloseUnsavedChangesModal();
            return;
        }

        hasUnsavedChanges = false;
        isUnsavedChangesModalVisible = false;
        allowNavigationOnce = true;
        var target = pendingNavigationTarget;
        pendingNavigationTarget = null;
        NavigationManager.NavigateTo(target);
    }

    private Task CloseUnsavedChangesModal()
    {
        isUnsavedChangesModalVisible = false;
        pendingNavigationTarget = null;
        return InvokeAsync(StateHasChanged);
    }

    private static string NormalizeGroupKey(string label)
    {
        if (string.IsNullOrWhiteSpace(label))
            return Guid.NewGuid().ToString("N");

        var chars = label
            .Where(c => char.IsLetterOrDigit(c))
            .Select(char.ToLowerInvariant)
            .ToArray();

        var key = new string(chars);
        if (string.IsNullOrWhiteSpace(key))
            return Guid.NewGuid().ToString("N");

        return key;
    }

